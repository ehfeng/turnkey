{
  "name": "turnkey",
  "version": "0.3.0",
  "private": true,
  "description": "Local viewer and validation tools for versioned house projects",
  "type": "module",
  "repository": "github:ehfeng/turnkey",
  "bin": {
    "turnkey": "./bin/turnkey.mjs"
  },
  "exports": {
    "./frame": "./lib/frame.mjs",
    "./furniture": "./lib/furniture.mjs",
    "./dom-stub": "./lib/dom-stub.mjs",
    "./validate": "./lib/validate.mjs",
    "./renderer-resources": "./lib/renderer-resources.mjs",
    "./collaboration-protocol": "./shared/collaboration-protocol.mjs",
    "./rooms": "./server/rooms.mjs",
    "./vite": "./lib/project-config.mjs",
    "./design": "./shared/design.mjs",
    "./design-store": "./server/design-store.mjs",
    "./design-api": "./server/design-api.mjs",
    "./design-plugin": "./server/design-plugin.mjs",
    "./catalog": "./shared/catalog.mjs",
    "./catalog-service": "./server/catalog.mjs",
    "./catalog-local": "./server/catalog-local.mjs",
    "./project": "./shared/project.mjs",
    "./project-merge": "./shared/project-merge.mjs",
    "./project-store": "./server/project-store.mjs",
    "./project-api": "./server/project-api.mjs",
    "./project-mcp": "./server/project-mcp.mjs",
    "./project-docs": "./server/project-docs.mjs",
    "./project-board": "./shared/project-board.mjs",
    "./project-assets": "./server/project-assets.mjs",
    "./project-board-tools": "./server/project-board-tools.mjs"
  },
  "files": [
    "bin",
    "lib",
    "server",
    "shared",
    "templates",
    "preview",
    "index.html",
    "schemas",
    "docs"
  ],
  "scripts": {
    "dev": "node bin/turnkey.mjs dev",
    "build": "node bin/turnkey.mjs build",
    "test": "node --test tests/*.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "three": "0.187.0",
    "vite": "8.3.8",
    "ws": "^8.23.0"
  }
}
